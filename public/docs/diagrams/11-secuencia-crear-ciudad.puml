@startuml 11-secuencia-crear-ciudad
!include _style.puml
title Secuencia - Crear ciudad
autonumber

actor "Administrador" as U
participant "CityForm.jsx\n<<view>>" as V
participant "api/city/route.js\n<<route>>" as R
participant "cityController\n<<controller>>" as C
participant "estateModel\n<<model>>" as EM
participant "cityModel\n<<model>>" as M
database "MySQL" as DB

U -> V : elige el departamento y llena los datos
V -> R : POST /api/city {codePostal, name, description, estateId}
R -> C : create(body)
C -> C : validate(data)
C -> EM : findById(estateId)
EM -> DB : SELECT
DB --> EM : resultado

alt el departamento no existe
  EM --> C : null
  C --> R : error de llave foránea
  R --> V : 404 Not Found
  V --> U : "El departamento no existe"
else el departamento existe
  EM --> C : Estate
  C -> M : insert(city)
  M -> DB : INSERT
  DB --> M : registro creado
  M --> C : City
  C --> R : City
  R --> V : 201 Created
  V --> U : muestra confirmación
end
@enduml
