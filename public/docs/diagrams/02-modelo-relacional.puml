@startuml 02-modelo-relacional
!include _style.puml
title Modelo relacional - project-mvc
hide circle
hide methods

package "client" {
  entity "Person" as Person {
    * Id : INT <<PK>>
    --
    * Name : VARCHAR(100)
    * Email : VARCHAR(150) <<UK>>
    Phone : VARCHAR(20)
  }

  entity "User" as User {
    * Id : INT <<PK>>
    --
    * User : VARCHAR(50) <<UK>>
    * Password : VARCHAR(255) <<hash>>
    * PersonId : INT <<FK>>
  }
}

package "reservation" {
  entity "ReservationType" as ReservationType {
    * Id : INT <<PK>>
    --
    * Name : VARCHAR(50) <<UK>>
    Description : VARCHAR(255)
  }

  entity "Reservation" as Reservation {
    * Id : INT <<PK>>
    --
    * Name : VARCHAR(100)
    * UserId : INT <<FK>>
    * ReservationTypeId : INT <<FK>>
    * CityId : INT <<FK>>
  }
}

package "ubication" {
  entity "Estate" as Estate {
    * Id : INT <<PK>>
    --
    * CodePostal : VARCHAR(10)
    * Name : VARCHAR(100)
    Description : VARCHAR(255)
  }

  entity "City" as City {
    * Id : INT <<PK>>
    --
    * CodePostal : VARCHAR(10)
    * Name : VARCHAR(100)
    Description : VARCHAR(255)
    * EstateId : INT <<FK>>
  }
}

Person ||--o{ User : tiene
User ||--o{ Reservation : realiza
ReservationType ||--o{ Reservation : clasifica
Estate ||--o{ City : contiene
City ||--o{ Reservation : ubica

legend right
  * = NOT NULL
  PK = llave primaria · FK = llave foránea · UK = único
endlegend
@enduml
